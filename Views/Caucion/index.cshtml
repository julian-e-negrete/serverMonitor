@model List<ServerMonitor.Models.CauctionData>

@{
    ViewData["Title"] = "Caución Data";
}

<div class="container mt-4">
    <h1 class="text-center mb-4">Caución Data</h1>
    
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Current Caución Rates</h5>
                </div>
                <div class="card-body">
                    <div id="cauction-data">
                        @foreach (var item in Model)
                        {
                            <div class="data-item mb-3 p-3 border rounded">
                                <div class="row">
                                    <div class="col-md-3">
                                        <strong class="fs-5">@item.Description</strong>
                                    </div>
                                    <div class="col-md-9">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <strong>Tasa:</strong> <span class="text-success fs-5">@item.Rate%</span>
                                            </div>
                                            <div class="col-md-3">
                                                <strong>Volumen:</strong> @item.Volume
                                            </div>
                                            <div class="col-md-3">
                                                <strong>Variación:</strong> 
                                                <span class="@(item.Variation.Contains("-") ? "text-danger" : "text-success")">
                                                    @item.Variation
                                                </span>
                                            </div>
                                            <div class="col-md-3 text-muted">
                                                <small>@item.Timestamp.ToString("HH:mm:ss")</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 text-center">
        <button id="refresh-btn" class="btn btn-outline-primary">
            <i class="fas fa-sync-alt"></i> Refresh
        </button>
        <small class="text-muted ms-3">Last updated: @DateTime.Now.ToString("HH:mm:ss")</small>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('refresh-btn').addEventListener('click', function() {
            location.reload();
        });

        // Auto-refresh every 30 seconds
        setInterval(() => {
            location.reload();
        }, 30000);
    </script>
}